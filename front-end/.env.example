# ============================================================
# NETRA Frontend — Environment Variables
# ============================================================
# Copy this file to .env and update the values as needed.
#
# IMPORTANT: VITE_ variables are exposed to the browser.
# Do NOT put secrets, passwords, or private API keys here.
# ============================================================

# Backend API base URL (Express.js server)
VITE_API_BASE_URL=http://localhost:5000/api
